#!/usr/bin/env bash
set -euo pipefail

# 本地八卡 TP8/DP1（PPU 4-11，端口 9038）：bash vln_demo/vllm/vllm38next
# 唯一维护版本在本仓库；用户目录及 runtime 的旧入口通过软链接访问本文件。
RUNTIME=/opt/external/user-d5121be6/model/flagos-qwen38-public/runtime
HERE=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")

MODEL_PATH=/data/Qwen3.8-Flash-Next # 隔离镜像内映射到 CPFS 原始权重。
export CUDA_VISIBLE_DEVICES=4,5,6,7,8,9,10,11
export PYTHONPATH="$RUNTIME/config"
export VLLM_LOGGING_CONFIG_PATH="$RUNTIME/config/vllm_log_hidden_id.json"

# 仓库插件按 PLE/GDN 各自状态规格分配复制缓冲区，保留一致的 token 块边界。
exec /usr/bin/python3 -I "$HERE/launch_next.py" "$RUNTIME/scripts/run_official.py" \
    /bin/bash /task/scripts/public_entrypoint.sh vllm serve "$MODEL_PATH" \
    --served-model-name qwen3.8-flash-next \
    --host 0.0.0.0 \
    --port 9038 \
    --tensor-parallel-size 8 \
    --data-parallel-size 1 \
    --dtype bfloat16 \
    --max-model-len 262144 \
    --max-num-seqs 256 \
    --enable-prefix-caching \
    --enable-prompt-tokens-details \
    --mamba-cache-mode align \
    --no-enable-flashinfer-autotune \
    --gpu-memory-utilization 0.85 \
    --reasoning-parser qwen3 \
    --tool-call-parser qwen3_xml \
    --enable-auto-tool-choice \
    --enable-log-requests \
    "$@"
